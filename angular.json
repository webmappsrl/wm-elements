{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "wm-elements": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/wm-elements",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": ["node_modules/graphhopper-js-api-client/dist/graphhopper-client.js"],
            "aot": false,
            "vendorChunk": true,
            "extractLicenses": false,
            "buildOptimizer": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "allowedCommonJsDependencies": [
              "togpx",
              "xml-utils/find-tags-by-name.js",
              "xml-utils/get-attribute.js",
              "lru-cache",
              "web-worker",
              "rbush",
              "graphhopper-js-api-client",
              "localforage",
              "color"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "main": "src/main.demo.ts",
              "index": "src/index.demo.html"
            },
            "demo-optimized": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false,
              "main": "src/main.demo.ts",
              "index": "src/index.demo.html"
            },
            "wm-layer-map": {
              "main": "src/main.ts",
              "index": "src/index.html",
              "outputPath": "dist/wm-layer-map"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "wm-elements:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "wm-elements:build:production"
            },
            "development": {
              "buildTarget": "wm-elements:build:development"
            },
            "demo": {
              "buildTarget": "wm-elements:build:demo"
            },
            "demo-optimized": {
              "buildTarget": "wm-elements:build:demo-optimized"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "wm-elements:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": []
          }
        }
      }
    }
  }
}
